    "process": {
      "type": "sr-process",
      "settings": {
        "kicker": "How bespoke works",
        "heading": "<p>We make <em>your idea</em></p>",
        "text": "From a photo on your phone to a finished bed in your bedroom. Five simple steps, one team.",
        "button_label": "Start your bespoke bed",
        "button_link": "shopify://pages/bespoke-beds-uk"
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Your idea",
            "text": "Send us a photo, drawing, screenshot or a bed you want recreated, or simply describe what you want."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "We discuss",
            "text": "We confirm the dimensions, fabric, colour, headboard, storage and mattress with you, and send a clear quote."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "We create",
            "text": "Your bed is made by hand in our West Yorkshire workshop to the exact specification we agreed."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "We deliver",
            "text": "Our own team delivers it free to your door anywhere on mainland UK."
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "title": "You enjoy",
            "text": "The finished bed arrives ready for its new home, backed by our 5-year warranty."
          }
        }
      },
