    "faq": {
      "type": "sr-faq",
      "settings": {
        "kicker": "Good to know",
        "heading": "<p>Questions, <em>answered</em></p>",
        "text": "",
        "button_label": "Ask us anything",
        "button_link": "shopify://pages/contact",
        "open_first": true,
        "schema": true,
        "bg": "linen"
      },
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "q": "Is delivery really free?",
            "a": "<p>Yes. Delivery is free to mainland UK addresses, and our own team brings your bed to your door. If you are outside mainland UK, please contact us before ordering and we will confirm the options.</p>",
            "only_on": ""
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "q": "How long will my bed take to arrive?",
            "a": "<p>Every bed is made to order. Most orders are delivered within 3–5 working days. We will contact you to arrange a delivery day that suits you.</p>",
            "only_on": ""
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "q": "Can you make a bed in a custom size, fabric or design?",
            "a": "<p>Often, yes. Because we make every bed by hand, custom sizes, fabrics, colours, headboard heights and storage are usually possible. Send us a photo, sketch or description through our <a href=\"/pages/bespoke-beds-uk#quote\">bespoke quote form</a> and we will talk it through with you.</p>",
            "only_on": ""
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "q": "Can I see the fabric before I order?",
            "a": "<p>Yes. Colours look different on every screen, so we post free fabric swatches. <a href=\"/pages/request-a-swatch\">Request your swatches here</a>.</p>",
            "only_on": ""
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "q": "What warranty do I get?",
            "a": "<p>Our beds are built on solid wood frames and come with a 5-year warranty. See our <a href=\"/pages/warranty\">warranty page</a> for the details.</p>",
            "only_on": ""
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "q": "Can I spread the cost?",
            "a": "<p>Yes. Klarna and Clearpay are available at checkout. See <a href=\"/pages/finance-options\">finance options</a>.</p>",
            "only_on": ""
          }
        },
        "faq_7": {
          "type": "faq",
          "settings": {
            "q": "Where are your beds made?",
            "a": "<p>In our workshop on Pepproyd Street, Dewsbury, West Yorkshire. You are buying direct from the people who make the bed.</p>",
            "only_on": ""
          }
        }
      },
      "block_order": [
