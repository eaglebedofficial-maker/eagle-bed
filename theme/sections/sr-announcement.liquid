<div class="sr sr-ann" data-sr-ann role="region" aria-label="Store announcements">
  <div class="sr-ann__in">
    {%- for block in section.blocks -%}
      {%- if block.settings.link != blank -%}
        <a class="sr-ann__msg{% if forloop.first %} is-on{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% render 'sr-icon', icon: block.settings.icon %}{{ block.settings.text | escape }}</a>
      {%- else -%}
        <p class="sr-ann__msg{% if forloop.first %} is-on{% endif %}" style="margin:0" {{ block.shopify_attributes }}>{% render 'sr-icon', icon: block.settings.icon %}{{ block.settings.text | escape }}</p>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Showroom announcement",
  "class": "sr-ann-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery to mainland UK" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "truck", "label": "Truck" }, { "value": "spool", "label": "Handmade" }, { "value": "pencil", "label": "Bespoke" },
          { "value": "shield", "label": "Warranty" }, { "value": "card", "label": "Finance" }, { "value": "phone", "label": "Phone" }, { "value": "star", "label": "Star" }
        ] }
      ]
    }
  ],
  "presets": [{ "name": "Showroom announcement", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
