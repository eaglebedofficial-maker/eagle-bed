<section class="sr sr-sec sr-sec--tight{% if section.settings.style == 'linen' %} sr-sec--linen{% elsif section.settings.style == 'night' %} sr-sec--night{% endif %}" aria-label="{{ section.settings.label | escape }}">
  <div class="sr-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="sr-head sr-center" style="justify-content:center"><div class="sr-head__t"><h2 class="sr-h2" data-sr-reveal>{{ section.settings.heading | escape }}</h2></div></div>
    {%- endif -%}
    <ul class="sr-trust" role="list" style="list-style:none;margin:0;padding:0" data-sr-stagger>
      {%- for block in section.blocks -%}
        <li class="sr-trust__i" data-sr-reveal {{ block.shopify_attributes }}>
          <span class="sr-trust__ic">{% render 'sr-icon', icon: block.settings.icon %}</span>
          <div>
            <p class="sr-trust__t">{{ block.settings.title | escape }}</p>
            {%- if block.settings.text != blank -%}<p class="sr-trust__d">{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Showroom trust strip",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Why Eagle Bed" },
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "select", "id": "style", "label": "Background", "default": "linen", "options": [{ "value": "ivory", "label": "Ivory" }, { "value": "linen", "label": "Linen" }, { "value": "night", "label": "Night" }] }
  ],
  "blocks": [
    { "type": "item", "name": "Trust point", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
        { "value": "truck", "label": "Delivery" }, { "value": "spool", "label": "Handmade" }, { "value": "shield", "label": "Warranty" }, { "value": "card", "label": "Finance" },
        { "value": "pencil", "label": "Bespoke" }, { "value": "lock", "label": "Secure" }, { "value": "chat", "label": "Support" }, { "value": "leaf", "label": "Materials" }, { "value": "star", "label": "Reviews" }, { "value": "ruler", "label": "Custom size" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Free UK delivery" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Showroom trust strip", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
