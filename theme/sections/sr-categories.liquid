<section class="sr sr-sec" data-sr-rail aria-labelledby="SrCats-{{ section.id }}">
  <div class="sr-wrap">
    <div class="sr-head">
      <div class="sr-head__t">
        {%- if section.settings.kicker != blank -%}<p class="sr-kicker" data-sr-reveal="fade">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h2 id="SrCats-{{ section.id }}" class="sr-h2" data-sr-reveal>{{ section.settings.heading | remove: "<p>" | remove: "</p>" }}</h2>
        {%- if section.settings.text != blank -%}<p class="sr-lead" data-sr-reveal>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      <div class="sr-arrows">
        <button type="button" class="sr-arrow" data-sr-dir="-1" aria-label="Previous categories">{% render 'sr-icon', icon: 'arrow-left' %}</button>
        <button type="button" class="sr-arrow" data-sr-dir="1" aria-label="More categories">{% render 'sr-icon', icon: 'arrow' %}</button>
      </div>
    </div>
    <ul class="sr-rail sr-cats" role="list" style="list-style:none;margin-top:0;margin-bottom:0" data-sr-stagger>
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign im = block.settings.image | default: c.image | default: c.products.first.featured_media.preview_image -%}
        <li data-sr-reveal {{ block.shopify_attributes }}>
          <a class="sr-cat" href="{{ c.url | default: '#' }}" data-sr-tilt data-sr-track="category_click" data-sr-label="{{ block.settings.title | default: c.title | escape }}">
            {%- if im -%}{{ im | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 31vw, 62vw', loading: 'lazy', alt: '' }}{%- endif -%}
            <span class="sr-cat__glare" aria-hidden="true"></span>
            <span class="sr-cat__b">
              <span>
                <span class="sr-cat__t">{{ block.settings.title | default: c.title | escape }}</span>
                {%- if c and section.settings.show_count -%}<span class="sr-cat__n" style="display:block">{{ c.products_count }} designs</span>{%- endif -%}
              </span>
              <span class="sr-cat__go" aria-hidden="true">{% render 'sr-icon', icon: 'arrow' %}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.link_label != blank -%}<p style="margin:8px 0 0"><a class="sr-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}{% render 'sr-icon', icon: 'arrow' %}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Showroom categories",
  "max_blocks": 14,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Explore the showroom" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Find your <em>style</em></p>" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_count", "label": "Show number of designs", "default": true },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Title override" },
      { "type": "image_picker", "id": "image", "label": "Image override" }
    ] }
  ],
  "presets": [{ "name": "Showroom categories", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
