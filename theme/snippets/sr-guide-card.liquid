<a class="sr-guide" href="{{ article.url }}" data-sr-track="guide_click" data-sr-label="{{ article.title | escape }}">
  <div class="sr-guide__m">
    {%- if article.image -%}
      {{ article.image | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '(min-width: 990px) 30vw, 78vw', loading: 'lazy', alt: '' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  {%- if kicker != blank -%}<p class="sr-guide__k">{{ kicker | escape }}</p>{%- endif -%}
  <h3>{{ article.title | escape }}</h3>
  <p>{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
</a>
