{%- comment -%} Eagle Bed — Delivery Timeline (fully editable section). Dates auto-calculate from today. {%- endcomment -%}
{%- assign uid = 'dt-' | append: section.id -%}
{%- assign rf = section.settings.ready_from -%}
{%- assign rt = section.settings.ready_to -%}
{%- assign df = section.settings.delivered_from -%}
{%- assign dt = section.settings.delivered_to -%}
{%- assign day = 86400 -%}
{%- assign now_ts = 'now' | date: '%s' | times: 1 -%}
{%- assign ordered_date = now_ts | date: '%-d %b' -%}
{%- assign ready_start = rf | times: day | plus: now_ts | date: '%-d %b' -%}
{%- assign ready_end = rt | times: day | plus: now_ts | date: '%-d %b' -%}
{%- assign del_start = df | times: day | plus: now_ts | date: '%-d %b' -%}
{%- assign del_end = dt | times: day | plus: now_ts | date: '%-d %b' -%}
<div id="{{ uid }}" class="dt-wrap" style="--a:{{ section.settings.accent }};--b:{{ section.settings.accent_2 }};--bg:{{ section.settings.background }};">
  <div class="dt-card">
    {%- if section.settings.heading != blank -%}<p class="dt-h">{{ section.settings.heading }}</p>{%- endif -%}
    <div class="dt-track"><div class="dt-line"></div>
      <div class="dt-step"><div class="dt-node"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 3h2.2l1 4m0 0 1.6 8.2a1.5 1.5 0 0 0 1.5 1.2h7.7a1.5 1.5 0 0 0 1.5-1.1l1.7-6.6a.8.8 0 0 0-.8-1H5.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="20" r="1.4" fill="currentColor"/><circle cx="17.5" cy="20" r="1.4" fill="currentColor"/></svg></div><div class="dt-lab">{{ section.settings.step_1 }}</div><div class="dt-date">{{ ordered_date }}</div></div>
      <div class="dt-step"><div class="dt-node"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21 8.2 12 3 3 8.2v7.6L12 21l9-5.2V8.2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M3 8.2 12 13.4l9-5.2M12 13.4V21" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></div><div class="dt-lab">{{ section.settings.step_2 }}</div><div class="dt-date">{% if rf == rt %}{{ ready_start }}{% else %}{{ ready_start }} – {{ ready_end }}{% endif %}</div></div>
      <div class="dt-step"><div class="dt-node"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 6.5h10.5v9H2.5zM13 9h4l3 3v3.5h-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="18" r="1.9" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="18" r="1.9" stroke="currentColor" stroke-width="1.8"/></svg></div><div class="dt-lab">{{ section.settings.step_3 }}</div><div class="dt-date">{% if df == dt %}{{ del_start }}{% else %}{{ del_start }} – {{ del_end }}{% endif %}</div></div>
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="dt-foot"><span class="dt-badge"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>{{ section.settings.footnote }}</span></p>
    {%- endif -%}
  </div>
</div>
<style>
  #{{ uid }} { padding:{{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px; background:var(--bg); }
  #{{ uid }} .dt-card { --text:#121212; --muted:#6b6b6b; max-width:760px; margin:0 auto; padding:24px 16px 20px; background:#f7f1ec; border:1px solid rgba(0,0,0,.06); border-radius:16px; text-align:center; box-shadow:0 2px 10px rgba(18,18,18,.04); }
  #{{ uid }} .dt-h { margin:0 0 18px; font-weight:700; font-size:1.05rem; color:var(--text); }
  #{{ uid }} .dt-track { position:relative; display:flex; justify-content:space-between; align-items:flex-start; gap:6px; }
  #{{ uid }} .dt-line { position:absolute; top:28px; left:16%; right:16%; height:3px; background:linear-gradient(90deg,var(--a),var(--b)); border-radius:3px; z-index:0; }
  #{{ uid }} .dt-step { position:relative; z-index:1; flex:1; display:flex; flex-direction:column; align-items:center; }
  #{{ uid }} .dt-node { width:56px; height:56px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; background:linear-gradient(135deg,var(--a),var(--b)); box-shadow:0 6px 16px rgba(127,40,91,.3); border:4px solid #f7f1ec; }
  #{{ uid }} .dt-node svg { width:27px; height:27px; }
  #{{ uid }} .dt-lab { margin-top:12px; font-weight:600; font-size:.72rem; text-transform:uppercase; letter-spacing:.9px; color:var(--muted); }
  #{{ uid }} .dt-date { margin-top:8px; display:inline-block; font-size:.92rem; font-weight:700; color:var(--a); background:#fff; padding:5px 13px; border-radius:999px; border:1px solid rgba(127,40,91,.16); box-shadow:0 2px 6px rgba(127,40,91,.12); white-space:nowrap; }
  #{{ uid }} .dt-foot { margin:22px 0 0; font-size:.83rem; color:var(--text); font-weight:500; display:inline-flex; align-items:center; gap:7px; }
  #{{ uid }} .dt-foot strong { color:var(--a); font-weight:700; }
  #{{ uid }} .dt-badge { display:inline-flex; align-items:center; justify-content:center; flex:0 0 auto; width:19px; height:19px; border-radius:50%; background:var(--a); color:#fff; }
  #{{ uid }} .dt-badge svg { width:12px; height:12px; }
  @media (max-width:480px){ #{{ uid }} .dt-node { width:48px; height:48px; } #{{ uid }} .dt-node svg { width:23px; height:23px; } #{{ uid }} .dt-line { top:24px; } #{{ uid }} .dt-lab { font-size:.66rem; } #{{ uid }} .dt-date { font-size:.8rem; padding:4px 9px; } }
</style>
{% schema %}
{
  "name": "Eagle Delivery Timeline",
  "tag": "section",
  "class": "eagle-timeline-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "text", "id": "step_1", "label": "Step 1 label", "default": "Ordered" },
    { "type": "text", "id": "step_2", "label": "Step 2 label", "default": "Order Ready" },
    { "type": "text", "id": "step_3", "label": "Step 3 label", "default": "Delivered" },
    { "type": "header", "content": "Timing (days from order)" },
    { "type": "range", "id": "ready_from", "label": "Order ready — from", "min": 0, "max": 14, "step": 1, "default": 1 },
    { "type": "range", "id": "ready_to", "label": "Order ready — to", "min": 0, "max": 14, "step": 1, "default": 2 },
    { "type": "range", "id": "delivered_from", "label": "Delivered — from", "min": 1, "max": 30, "step": 1, "default": 3 },
    { "type": "range", "id": "delivered_to", "label": "Delivered — to", "min": 1, "max": 30, "step": 1, "default": 5 },
    { "type": "inline_richtext", "id": "footnote", "label": "Footnote", "default": "Free delivery within <strong>3–5 working days</strong> across mainland UK." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent", "label": "Accent (start)", "default": "#7f285b" },
    { "type": "color", "id": "accent_2", "label": "Accent (end)", "default": "#a83b76" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 16 }
  ],
  "presets": [{ "name": "Eagle Delivery Timeline" }]
}
{% endschema %}
