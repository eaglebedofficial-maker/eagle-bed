{%- comment -%}
  Eagle Bed — Delivery Timeline
  Ordered → Order Ready → Delivered, with live dates.
  Dates auto-calculate from today using the ranges set in the theme editor.
{%- endcomment -%}

{%- assign day = 86400 -%}
{%- assign now_ts = 'now' | date: '%s' | times: 1 -%}

{%- assign prep_min_secs = section.settings.prep_min | times: day -%}
{%- assign prep_max_secs = section.settings.prep_max | times: day -%}
{%- assign del_min_secs = section.settings.delivery_min | times: day -%}
{%- assign del_max_secs = section.settings.delivery_max | times: day -%}

{%- assign ordered_date = now_ts | date: '%-d %b' -%}
{%- assign ready_start = now_ts | plus: prep_min_secs | date: '%-d %b' -%}
{%- assign ready_end = now_ts | plus: prep_max_secs | date: '%-d %b' -%}
{%- assign del_start = now_ts | plus: del_min_secs | date: '%-d %b' -%}
{%- assign del_end = now_ts | plus: del_max_secs | date: '%-d %b' -%}

<div class="eagle-dt" id="eagle-dt-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="eagle-dt__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <p class="eagle-dt__sub">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <div class="eagle-dt__track">
    <div class="eagle-dt__line"></div>

    <div class="eagle-dt__step">
      <div class="eagle-dt__node">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M2.5 3h2.2l1 4m0 0 1.6 8.2a1.5 1.5 0 0 0 1.5 1.2h7.7a1.5 1.5 0 0 0 1.5-1.1l1.7-6.6a.8.8 0 0 0-.8-1H5.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.5" cy="20" r="1.4" fill="currentColor"/>
          <circle cx="17.5" cy="20" r="1.4" fill="currentColor"/>
        </svg>
      </div>
      <div class="eagle-dt__label">{{ section.settings.label_1 }}</div>
      <div class="eagle-dt__date">{{ ordered_date }}</div>
    </div>

    <div class="eagle-dt__step">
      <div class="eagle-dt__node">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M21 8.2 12 3 3 8.2v7.6L12 21l9-5.2V8.2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M3 8.2 12 13.4l9-5.2M12 13.4V21" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="eagle-dt__label">{{ section.settings.label_2 }}</div>
      <div class="eagle-dt__date">{{ ready_start }} – {{ ready_end }}</div>
    </div>

    <div class="eagle-dt__step">
      <div class="eagle-dt__node">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M2.5 6.5h10.5v9H2.5zM13 9h4l3 3v3.5h-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <circle cx="7" cy="18" r="1.9" stroke="currentColor" stroke-width="1.8"/>
          <circle cx="17" cy="18" r="1.9" stroke="currentColor" stroke-width="1.8"/>
        </svg>
      </div>
      <div class="eagle-dt__label">{{ section.settings.label_3 }}</div>
      <div class="eagle-dt__date">{{ del_start }} – {{ del_end }}</div>
    </div>
  </div>

  {%- if section.settings.footnote != blank -%}
    <p class="eagle-dt__foot">{{ section.settings.footnote }}</p>
  {%- endif -%}
</div>

<style>
  #eagle-dt-{{ section.id }} {
    --dt-accent: {{ section.settings.accent }};
    --dt-accent-2: {{ section.settings.accent_2 }};
    --dt-text: {{ section.settings.text_color }};
    --dt-muted: {{ section.settings.muted_color }};
    max-width: 820px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
    border-radius: 16px;
    text-align: center;
    font-family: inherit;
  }
  #eagle-dt-{{ section.id }} .eagle-dt__heading {
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    font-weight: 700;
    color: var(--dt-text);
    margin: 0 0 6px;
  }
  #eagle-dt-{{ section.id }} .eagle-dt__sub {
    font-size: .95rem;
    color: var(--dt-muted);
    margin: 0 0 30px;
  }
  #eagle-dt-{{ section.id }} .eagle-dt__track {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  #eagle-dt-{{ section.id }} .eagle-dt__line {
    position: absolute;
    top: 32px;
    left: 14%;
    right: 14%;
    height: 3px;
    background: linear-gradient(90deg, var(--dt-accent), var(--dt-accent-2));
    border-radius: 3px;
    z-index: 0;
  }
  #eagle-dt-{{ section.id }} .eagle-dt__step {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  #eagle-dt-{{ section.id }} .eagle-dt__node {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: linear-gradient(135deg, var(--dt-accent), var(--dt-accent-2));
    box-shadow: 0 6px 18px rgba(127,40,91,.28);
    border: 4px solid {{ section.settings.background }};
  }
  #eagle-dt-{{ section.id }} .eagle-dt__node svg { width: 30px; height: 30px; }
  #eagle-dt-{{ section.id }} .eagle-dt__label {
    margin-top: 14px;
    font-weight: 700;
    font-size: 1rem;
    color: var(--dt-text);
  }
  #eagle-dt-{{ section.id }} .eagle-dt__date {
    margin-top: 4px;
    font-size: .9rem;
    color: var(--dt-muted);
  }
  #eagle-dt-{{ section.id }} .eagle-dt__foot {
    margin: 26px 0 0;
    font-size: .82rem;
    color: var(--dt-muted);
  }
  @media (max-width: 600px) {
    #eagle-dt-{{ section.id }} .eagle-dt__node { width: 54px; height: 54px; }
    #eagle-dt-{{ section.id }} .eagle-dt__node svg { width: 26px; height: 26px; }
    #eagle-dt-{{ section.id }} .eagle-dt__line { top: 27px; }
    #eagle-dt-{{ section.id }} .eagle-dt__label { font-size: .9rem; }
    #eagle-dt-{{ section.id }} .eagle-dt__date { font-size: .8rem; }
  }
</style>

{% schema %}
{
  "name": "Eagle Delivery Timeline",
  "tag": "section",
  "class": "eagle-delivery-timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fast, Free UK Delivery" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Handmade to order and dispatched from our West Yorkshire warehouse" },
    { "type": "header", "content": "Steps" },
    { "type": "text", "id": "label_1", "label": "Step 1 label", "default": "Ordered" },
    { "type": "text", "id": "label_2", "label": "Step 2 label", "default": "Order Ready" },
    { "type": "text", "id": "label_3", "label": "Step 3 label", "default": "Delivered" },
    { "type": "header", "content": "Timing (days from order)" },
    { "type": "range", "id": "prep_min", "label": "Order ready — from (days)", "min": 0, "max": 14, "step": 1, "default": 1 },
    { "type": "range", "id": "prep_max", "label": "Order ready — to (days)", "min": 0, "max": 14, "step": 1, "default": 2 },
    { "type": "range", "id": "delivery_min", "label": "Delivered — from (days)", "min": 1, "max": 30, "step": 1, "default": 3 },
    { "type": "range", "id": "delivery_max", "label": "Delivered — to (days)", "min": 1, "max": 30, "step": 1, "default": 5 },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Delivery within 3–5 working days across mainland UK." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "accent", "label": "Accent (start)", "default": "#7f285b" },
    { "type": "color", "id": "accent_2", "label": "Accent (end)", "default": "#a83b76" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6b6b6b" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f2e8e0" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 40 }
  ],
  "presets": [
    { "name": "Eagle Delivery Timeline" }
  ]
}
{% endschema %}
