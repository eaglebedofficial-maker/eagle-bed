{%- comment -%}
  Speed (9 Nov 2026): tell the browser about the home page banner photo straight away, so it starts
  downloading before the rest of the page. It must match the first banner's collection in the
  "3D bed hero" section (currently Wingback Beds). If you change that banner, change the handle here.
{%- endcomment -%}
{%- comment -%} Speed (10 Nov 2026): fonts and the main 3D stylesheet start downloading from the head instead of
  being discovered late (the fonts used to be an @import inside eb3d.css). Fonts never block the first paint. {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400&family=Manrope:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400&family=Manrope:wght@400;500;600;700&display=swap"></noscript>
<link rel="preload" as="style" href="{{ 'eb3d.css' | asset_url }}">
<link rel="preload" as="style" href="{{ 'eb3d-chrome.css' | asset_url }}">
<style>
  /* Phones: glass blur effects are expensive to paint on mobile CPUs; plain translucent panels look almost the same. */
  @media (max-width: 900px) {
    [class*="eb3d"] { -webkit-backdrop-filter: none !important; backdrop-filter: none !important; }
    .eb3d-hero:before { filter: none !important; opacity: .35 !important; }
  }
  /* Sections far below the first screen are rendered only when the shopper scrolls near them. */
  #MainContent > .shopify-section:nth-child(n+4):not([id*="cinema"]):not([id*="anatomy"]):not([id*="product"]) { content-visibility: auto; contain-intrinsic-size: auto 900px; }
</style>
{%- comment -%} Speed (10 Nov 2026): the main photo of collection and product pages also starts downloading straight away.
  widths/sizes match sections/eb3d-collection.liquid (collection hero) and sections/eb3d-product.liquid (first gallery photo). {%- endcomment -%}
{%- if request.page_type == 'collection' and collection.image -%}
  <link rel="preload" as="image" fetchpriority="high" href="{{ collection.image | image_url: width: 1100 }}" imagesrcset="{{ collection.image | image_url: width: 500 }} 500w, {{ collection.image | image_url: width: 800 }} 800w, {{ collection.image | image_url: width: 1100 }} 1100w" imagesizes="(min-width: 900px) 40vw, 90vw">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  {%- assign eb_pm = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
  {%- if eb_pm -%}
    <link rel="preload" as="image" fetchpriority="high" href="{{ eb_pm.preview_image | image_url: width: 1400 }}" imagesrcset="{{ eb_pm.preview_image | image_url: width: 600 }} 600w, {{ eb_pm.preview_image | image_url: width: 900 }} 900w, {{ eb_pm.preview_image | image_url: width: 1200 }} 1200w, {{ eb_pm.preview_image | image_url: width: 1400 }} 1400w" imagesizes="(min-width: 990px) 55vw, 100vw">
  {%- endif -%}
{%- endif -%}
{%- if template.name == 'index' -%}
  {%- assign eb_hero = collections['wingback-beds'].image -%}
  {%- if eb_hero -%}
    <link rel="preload" as="image" fetchpriority="high" href="{{ eb_hero | image_url: width: 1400 }}" imagesrcset="{{ eb_hero | image_url: width: 480 }} 480w, {{ eb_hero | image_url: width: 600 }} 600w, {{ eb_hero | image_url: width: 720 }} 720w, {{ eb_hero | image_url: width: 900 }} 900w, {{ eb_hero | image_url: width: 1200 }} 1200w, {{ eb_hero | image_url: width: 1400 }} 1400w" imagesizes="(min-width: 901px) 58vw, 100vw">
  {%- endif -%}
{%- endif -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

{%- comment -%} Eagle Bed: keep thin duplicate listings and internal search results out of the index {%- endcomment -%}
{%- if request.page_type == 'collection' -%}
  {%- if collection.handle == 'frontpage' or collection.handle == 'new-trending' or collection.handle == 'all' -%}
    <meta name="robots" content="noindex, follow">
  {%- endif -%}
{%- endif -%}
{%- if request.page_type == 'search' -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

<meta name="robots" content="max-image-preview:large">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- comment -%}
  Eagle Bed entity structured data (S13). One JSON-LD graph.
  Homepage: Organization (#organization) + WebSite (#website, SearchAction) + FurnitureStore (#store).
  All other pages: the FurnitureStore node only (single LocalBusiness, never duplicated).
  Facts: Pepproyd Street, Eastborough, Dewsbury WF13 1PA; +44 7417 439197; Mo-Fr 09:00-18:00. No geo, no ratings.
{%- endcomment -%}
{%- unless request.page_type == 'password' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {%- if template.name == 'index' %}
    {
      "@type": "Organization",
      "@id": "https://www.eaglebed.co.uk/#organization",
      "name": "Eagle Bed",
      "alternateName": ["EagleBed", "Eagle Bed Dewsbury"],
      "url": "https://www.eaglebed.co.uk/",
      "description": "Eagle Bed makes fully upholstered fabric and velvet beds by hand to order in its own workshop in Dewsbury, West Yorkshire.",
      "email": "eaglebedofficial@gmail.com",
      "telephone": "+44 7417 439197",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Pepproyd Street, Eastborough",
        "addressLocality": "Dewsbury",
        "addressRegion": "West Yorkshire",
        "postalCode": "WF13 1PA",
        "addressCountry": "GB"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "telephone": "+44 7417 439197",
        "email": "eaglebedofficial@gmail.com",
        "areaServed": "GB",
        "availableLanguage": "English"
      },
      {%- if settings.logo != blank %}
      "logo": { "@type": "ImageObject", "url": {{ settings.logo | image_url: width: 512 | prepend: 'https:' | json }} },
      {%- endif %}
      "sameAs": [
        "https://www.facebook.com/share/1GQsNDz1cV/",
        "https://www.instagram.com/eaglebed.co.uk",
        "https://www.tiktok.com/@eagle.bed"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.eaglebed.co.uk/#website",
      "url": "https://www.eaglebed.co.uk/",
      "name": "Eagle Bed",
      "inLanguage": "en-GB",
      "publisher": { "@id": "https://www.eaglebed.co.uk/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": "https://www.eaglebed.co.uk/search?q={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {%- endif %}
    {
      "@type": "FurnitureStore",
      "@id": "https://www.eaglebed.co.uk/#store",
      "name": "Eagle Bed",
      "url": "https://www.eaglebed.co.uk/",
      "telephone": "+44 7417 439197",
      "email": "eaglebedofficial@gmail.com",
      "priceRange": "££",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Pepproyd Street, Eastborough",
        "addressLocality": "Dewsbury",
        "addressRegion": "West Yorkshire",
        "postalCode": "WF13 1PA",
        "addressCountry": "GB"
      },
      "areaServed": { "@type": "Country", "name": "United Kingdom" },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "parentOrganization": { "@id": "https://www.eaglebed.co.uk/#organization" }
    }
  ]
}
</script>
{%- endunless -%}
