{{ 'eb3d.css' | asset_url | stylesheet_tag }}
<script src="{{ 'eb3d.js' | asset_url }}" defer></script>
<div class="eb3d eb3d-cats">
  <div class="eb3d-wrap">
    <div class="eb3d-head">
      <div>
        <h2 class="eb3d-h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="eb3d-lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="eb3d-link" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="eb3d-cats__grid">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank -%}{%- continue -%}{%- endif -%}
        {%- assign img = c.image -%}
        {%- if img == blank and c.products.first.featured_media -%}{%- assign img = c.products.first.featured_media.preview_image -%}{%- endif -%}
        {%- comment -%} Speed (10 Nov 2026): sizes match the real tile width on phones, so phones load a 500-600px image instead of 1000px. {%- endcomment -%}
        {%- if forloop.first -%}{%- assign sz = '(min-width: 900px) 50vw, calc(100vw - 40px)' -%}{%- else -%}{%- assign sz = '(min-width: 900px) 25vw, calc(50vw - 26px)' -%}{%- endif -%}
        <a class="eb3d-cat" href="{{ c.url }}" data-tilt="{% if forloop.first %}6{% else %}10{% endif %}" {{ block.shopify_attributes }}>
          <div class="eb3d-cat__plate">
            <div class="eb3d-cat__img">
              {%- if img -%}{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300,400,500,600,700,1000,1200', sizes: sz, alt: c.title }}{%- endif -%}
            </div>
            <span class="eb3d-cat__glare"></span>
            <span class="eb3d-cat__seam"></span>
            <div class="eb3d-cat__label">
              <span class="eb3d-cat__name">{{ block.settings.title | default: c.title | escape }}</span>
              <span class="eb3d-cat__count">{{ c.products_count }} designs</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "3D categories",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by bed" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All collections" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Title override" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "3D categories", "blocks": [ { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" } ] } ]
}
{% endschema %}
