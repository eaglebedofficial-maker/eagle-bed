# Kestrel API configuration. Copy to .env (local) or set as environment variables.
ENVIRONMENT=development                  # development | production
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/kestrel
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
COOKIE_SECURE=false                      # true behind HTTPS

STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# Optional: email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional platform fallback for the AI assistant. Organisations normally add their own key
# in Settings → Integrations (stored encrypted).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

DEMO_LOGIN_ENABLED=true                  # one-click access to the fictional demo workspace
RATE_LIMIT_PER_MINUTE=240
