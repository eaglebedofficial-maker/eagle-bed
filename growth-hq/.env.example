# Required
APP_SECRET=change-me-to-at-least-32-random-characters   # encrypts stored keys and signs sessions
APP_URL=http://localhost:3000                            # public URL (used for OAuth redirects)
CRON_SECRET=another-long-random-string                   # protects /api/cron/autopilot

# Optional
CLAUDE_MODEL=claude-opus-5-5
DATA_DIR=./data

# OAuth apps (create one per provider; redirect URI = APP_URL/api/oauth/<id>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v22
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Override any MCP server URL, e.g.
# CONN_SHOPIFY_MCP_URL=https://...

# Payments (Stripe). Without STRIPE_SECRET_KEY everything is free (good for testing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=            # webhook endpoint: APP_URL/api/billing/webhook
TRIAL_DAYS=7                      # free trial length for new customers (0 = none)
OWNER_EMAILS=                     # comma-separated; these accounts never pay (your own company)
SHOPIFY_API_VERSION=2025-10
